# Copy to .env and fill in. Never commit .env.

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Free, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Only these Telegram user ids can use the bot (comma-separated). Message the bot once
# and it will tell you your id. Leave empty to allow everyone (not recommended).
ALLOWED_USER_IDS=

# polling = run anywhere, no public URL. webhook = Telegram pushes to WEBHOOK_URL/webhook.
MODE=polling
WEBHOOK_URL=
WEBHOOK_SECRET=

ASSISTANT_NAME=Ava
DEFAULT_TIMEZONE=UTC
# gemini-flash-lite-latest has the biggest free daily allowance; gemini-flash-latest is smarter but allows fewer requests
GEMINI_MODEL=gemini-flash-lite-latest
# Any edge-tts voice, e.g. en-GB-SoniaNeural, en-US-GuyNeural (list: edge-tts --list-voices)
TTS_VOICE=en-US-AriaNeural
DB_PATH=assistant.db
